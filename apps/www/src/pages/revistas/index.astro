---
import BaseLayout from '@pledin/ui/layouts/BaseLayout.astro';
import revistas from '../../data/revistas.json';

const actuales = revistas.filter(r => r.tipo === 'actual');
const antiguas = revistas.filter(r => r.tipo === 'antigua');
---

<BaseLayout title="Revistas de Software Libre">
  <div class="revistas-wrapper">

      <section class="hero">
        <img src="/pledin/assets/revistas.jpg" alt="Colección de revistas" class="hero-img" />
        <h1>Revistas Libres de Software Libre</h1>
        <p>Colección de revistas digitales libres sobre Software Libre, Linux, Educación y Tecnología...</p>
      </section>

    <!-- Revistas actuales -->
    <section class="revistas-section">
      <h2 class="section-title">Revistas actuales</h2>
      <div class="revistas-grid">
        {actuales.map(r => (
          <div class="revista-card">
            <div class="revista-img">
              <img src={`/pledin/revistas/img/${r.img}`} alt={r.name} />
            </div>
            <div class="revista-body">
              <h3 class="revista-name">{r.name}</h3>
              <p class="revista-desc">{r.descripcion}</p>
              {r.ultimo_numero && (
                <p class="revista-meta">
                  <span class="meta-label">Último número:</span> {r.ultimo_numero}
                </p>
              )}
              <div class="revista-links">
                <a href={r.url} class="btn-acceder" target="_blank" rel="noopener">
                  Acceder →
                </a>
                {r.web && (
                  <a href={r.web} class="btn-web" target="_blank" rel="noopener">
                    Página web
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Revistas antiguas -->
    <section class="revistas-section">
      <h2 class="section-title">Archivo histórico</h2>
      <p class="section-subtitle">Revistas que ya no están activas o corresponden a épocas anteriores.</p>
      <div class="revistas-grid">
        {antiguas.map(r => (
          <div class="revista-card revista-card--antigua">
            <div class="revista-img">
              <img src={`/pledin/revistas/img/${r.img}`} alt={r.name} />
            </div>
            <div class="revista-body">
              <div class="antigua-badge">Archivo</div>
              <h3 class="revista-name">{r.name}</h3>
              <p class="revista-desc">{r.descripcion}</p>
              <div class="revista-meta-row">
                {r.numeros && (
                  <p class="revista-meta">
                    <span class="meta-label">Números:</span> {r.numeros}
                  </p>
                )}
                {r.years && (
                  <p class="revista-meta">
                    <span class="meta-label">Años:</span> {r.years}
                  </p>
                )}
              </div>
              <div class="revista-links">
                <a href={r.url} class="btn-acceder" target="_blank" rel="noopener">
                  Acceder →
                </a>
                {r.web && (
                  <a href={r.web} class="btn-web" target="_blank" rel="noopener">
                    Página web
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="license">
      <p>Licencia: Puedes copiar y modificar todos los contenidos, pero siempre respetando los términos de la licencia <a href="https://creativecommons.org/licenses/by-sa/3.0/es/">CC-BY-SA</a>.</p>
    </section>

  </div>
</BaseLayout>

<style>
  .revistas-wrapper {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 3rem;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 0 0 2rem;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .hero h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 40rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  .hero-img {
    width: 16rem;
    margin: 0 auto 1.5rem;
    display: block;
  }

  /* Secciones */
  .revistas-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 2px solid var(--color-border);
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  /* Grid */
  .revistas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  /* Tarjeta */
  .revista-card {
    background: var(--color-bg-sidebar);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s;
  }

  .revista-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .revista-card--antigua {
    opacity: 0.85;
  }

  .revista-card--antigua:hover {
    opacity: 1;
  }

  /* Imagen */
  .revista-img {
    width: 100%;
    height: 10rem;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .revista-img img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }

  /* Cuerpo */
  .revista-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .antigua-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-bg-sidebar);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    align-self: flex-start;
  }

  .revista-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .revista-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    /* Limitar a 4 líneas */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .revista-meta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .revista-meta {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .meta-label {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Links */
  .revista-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-acceder {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    background: var(--color-accent);
    padding: 0.4rem 0.9rem;
    border-radius: 0.4rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-acceder:hover {
    background: var(--color-accent-high);
  }

  .btn-web {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .btn-web:hover {
    color: var(--color-accent-high);
    text-decoration: underline;
  }

  /* Licencia */
  .license {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
    padding: 2rem 0;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .revistas-wrapper {
      padding: 1.5rem 1.25rem;
    }

    .revistas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
